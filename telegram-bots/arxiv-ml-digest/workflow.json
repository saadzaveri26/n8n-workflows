      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "const xml = $input.first().json.data;\n\nconst entries = xml.match(/<entry>([\\s\\S]*?)<\\/entry>/g) || [];\n\nconst papers = entries.map(entry => {\n  const title = (entry.match(/<title>([\\s\\S]*?)<\\/title>/) || [])[1]?.trim().replace(/\\s+/g, ' ') || 'No title';\n  const summary = (entry.match(/<summary>([\\s\\S]*?)<\\/summary>/) || [])[1]?.trim().replace(/\\s+/g, ' ') || 'No summary';\n  const link = (entry.match(/<id>([\\s\\S]*?)<\\/id>/) || [])[1]?.trim() || '';\n  const authors = [...entry.matchAll(/<name>([\\s\\S]*?)<\\/name>/g)].map(m => m[1].trim()).slice(0, 3).join(', ');\n\n  return { json: { title, summary, link, authors } };\n});\n\nreturn papers;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
