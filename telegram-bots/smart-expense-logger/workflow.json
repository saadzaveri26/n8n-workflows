      "parameters": {
        "jsCode": "const text = $input.first().json.message.text.trim();\nconst parts = text.split(' ');\n\nconst amount = parseFloat(parts.find(p => !isNaN(p))) || 0;\nconst category = parts.find(p => isNaN(p) && p !== parts[0]) || 'General';\nconst item = parts[0];\n\nconst now = new Date();\nconst date = now.toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata' });\nconst time = now.toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata' });\n\nreturn [{\n  json: {\n    date,\n    time,\n    item,\n    amount,\n    category,\n    raw: text\n  }\n}];"
      },
