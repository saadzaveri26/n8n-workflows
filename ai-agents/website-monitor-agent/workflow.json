      "parameters": {
        "jsCode": "const html = $input.first().json.data;\n\nconst clean = html\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, '')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, '')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .slice(0, 3000);\n\nreturn [{ json: { content: clean, url: 'https://anthropic.com/careers' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        144,
        16
      ],
      "id": "a5d33ec6-fa9e-4d0c-826f-5d5d36e9a0e5",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const current = $input.first().json.content;\nconst url = $input.first().json.url;\n\nconst stored = $getWorkflowStaticData('global');\nconst previous = stored[url] || '';\n\nconst hasChanged = previous !== '' && current !== previous;\n\nstored[url] = current;\n\nreturn [{\n  json: {\n    hasChanged,\n    current,\n    previous: previous.slice(0, 1000),\n    url,\n    isFirstRun: previous === ''\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
