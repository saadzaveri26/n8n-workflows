        "jsCode": "const text = $input.first().json.text;\nconst chunkSize = 500;\nconst overlap = 50;\n\nconst chunks = [];\nlet start = 0;\n\nwhile (start < text.length) {\n  const end = Math.min(start + chunkSize, text.length);\n  chunks.push({ json: { pageContent: text.slice(start, end) } });\n  start += chunkSize - overlap;\n}\n\nreturn chunks;"
