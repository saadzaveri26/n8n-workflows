    {
      "parameters": {
        "jsCode": "// Get the URL from the message\nconst url = $input.item.json.message.text;\nlet videoId = \"\";\n\n// Extract ID (works for youtu.be and youtube.com)\nif (url.includes(\"v=\")) {\n  videoId = url.split(\"v=\")[1].split(\"&\")[0];\n} else {\n  videoId = url.split(\"/\").pop().split(\"?\")[0];\n}\n\nreturn { json: { video_id: videoId } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "a86b6ead-f308-4ea8-8b6a-bebf93f63a44",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// The previous node returns an array of items. We need to join them.\nconst allItems = $input.all();\n\n// Map over all items to get the \"text\" field and join them\nconst fullTranscript = allItems.map(item => item.json.text).join(\" \");\n\nreturn { json: { transcript: fullTranscript } };"
      },
      "type": "n8n-nodes-base.code",
