      "name": "HTTP Request1"
    },
    {
      "parameters": {
        "jsCode": "const profile = $('HTTP Request').first().json;\nconst events = $('HTTP Request1').all().map(e => e.json);\n\nconst today = new Date().toISOString().split('T')[0];\n\nconst todayEvents = events.filter(e => e.created_at?.startsWith(today));\n\nconst activityMap = {};\ntodayEvents.forEach(e => {\n  const repo = e.repo?.name?.split('/')[1] || 'unknown';\n  const type = e.type;\n  if (!activityMap[repo]) activityMap[repo] = [];\n  activityMap[repo].push(type);\n});\n\nconst activityLines = Object.entries(activityMap).map(([repo, types]) => {\n  const pushes = types.filter(t => t === 'PushEvent').length;\n  const creates = types.filter(t => t === 'CreateEvent').length;\n  let line = repo;\n  if (pushes > 0) line += ` (${pushes} push${pushes > 1 ? 'es' : ''})`;\n  if (creates > 0) line += ` (created)`;\n  return line;\n});\n\nreturn [{\n  json: {\n    username: profile.login,\n    repos: profile.public_repos,\n    followers: profile.followers,\n    following: profile.following,\n    activity: activityLines.length > 0 ? activityLines.join('\\n- ') : 'No public activity today',\n    date: new Date().toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata' })\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
