    {
      "parameters": {
        "promptType": "define",
        "text": "=Extract action items from this voice note transcript. Return ONLY a valid JSON array, no other text, no markdown.\n\nTranscript: {{ $json.text }}\n\nReturn in this exact format:\n[\n  {\"task\": \"task description\", \"due\": \"deadline or ASAP\", \"priority\": \"High/Medium/Low\"}\n]\n\nIf no clear tasks exist, return an empty array [].",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        656,
        0
      ],
      "id": "9c3e7f37-7f3d-487b-9f12-257fcfcf75c5",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "model": "openai/gpt-oss-120b",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        656,
        176
      ],
      "id": "39f9b207-a00e-4a65-ba4a-d0b47075c9c6",
      "name": "Groq Chat Model",
      "credentials": {
        "groqApi": {
          "id": "tGo1yfI9F5qhSyFc",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output || $input.first().json.text;\nconst transcript = $('HTTP Request1').item.json.text || 'N/A';\n\nlet tasks;\ntry {\n  const cleaned = raw.replace(/```json|```/g, '').trim();\n  tasks = JSON.parse(cleaned);\n} catch(e) {\n  tasks = [];\n}\n\nconst now = new Date();\nconst date = now.toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata' });\n\nreturn tasks.map(t => ({\n  json: {\n    date,\n    task: t.task,\n    due: t.due,\n    priority: t.priority,\n    transcript: transcript.slice(0, 200)\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1008,
        0
      ],
      "id": "691f9ea1-bab2-4e42-a484-5313256640b9",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst taskList = items.map((item, i) => \n  `${i + 1}. ${item.json.task} — Due: ${item.json.due} — Priority: ${item.json.priority}`\n).join('\\n');\n\nreturn [{\n  json: {\n    summary: taskList || 'No clear tasks found in this voice note.',\n    count: items.length\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1216,
        0
      ],
      "id": "8d8f2e71-4d5c-4bd6-b941-f5a82e7c402a",
      "name": "Build Summary"
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "=Voice Note Processed!  Action Items: {{ $json.summary }}  {{ $json.count }} task(s) logged to your tracker.",
        "additionalFields": {}
      },
