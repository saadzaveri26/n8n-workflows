    {
      "parameters": {
        "jsCode": "const binary = $input.first().binary.data;\nbinary.fileName = 'audio.ogg';\nbinary.fileExtension = 'ogg';\nbinary.mimeType = 'audio/ogg';\n\nreturn [{\n  json: $input.first().json,\n  binary: { data: binary }\n}];"
      },
