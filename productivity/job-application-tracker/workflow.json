      "parameters": {
        "jsCode": "const raw = $input.first().json.output;\n\nlet parsed;\ntry {\n  const cleaned = raw.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch(e) {\n  parsed = {\n    company: 'Unknown',\n    role: 'Unknown', \n    status: 'Applied',\n    source: 'Unknown',\n    notes: raw\n  };\n}\n\nconst now = new Date();\nconst date = now.toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata' });\n\nreturn [{\n  json: {\n    date,\n    company: parsed.company || 'Unknown',\n    role: parsed.role || 'Unknown',\n    status: parsed.status || 'Applied',\n    source: parsed.source || 'Unknown',\n    notes: parsed.notes || ''\n  }\n}];"
