    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert technical recruiter and career coach. Analyze how well this CV matches the job description.\n\nJOB DESCRIPTION:\n{{ $('Code in JavaScript').item.json.jobDescription }}\n\nCV CONTENT:\n{{ $json.text.slice(0, 3000) }}\n\nReturn ONLY a JSON object in exactly this format, no other text:\n{\n  \"overall_score\": 75,\n  \"skills_score\": 80,\n  \"experience_score\": 70,\n  \"education_score\": 85,\n  \"matched_skills\": [\"skill1\", \"skill2\"],\n  \"missing_skills\": [\"skill1\", \"skill2\"],\n  \"strengths\": \"2-3 sentence summary of strengths\",\n  \"gaps\": \"2-3 sentence summary of gaps\",\n  \"verdict\": \"One line recommendation\",\n  \"role_name\": \"extracted job title\"\n}",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        960,
        -80
      ],
