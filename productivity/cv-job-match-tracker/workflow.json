          "id": "tGo1yfI9F5qhSyFc",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output || $input.first().json.text;\n\nlet parsed;\ntry {\n  const cleaned = raw.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch(e) {\n  parsed = {\n    overall_score: 0,\n    skills_score: 0,\n    experience_score: 0,\n    education_score: 0,\n    matched_skills: [],\n    missing_skills: [],\n    strengths: 'Parse error',\n    gaps: 'Parse error',\n    verdict: 'Could not analyze',\n    role_name: 'Unknown'\n  };\n}\n\nconst now = new Date();\nconst date = now.toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata' });\n\nreturn [{\n  json: {\n    ...parsed,\n    date,\n    matched_skills_str: parsed.matched_skills?.join(', ') || '',\n    missing_skills_str: parsed.missing_skills?.join(', ') || ''\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1312,
        -80
      ],
      "id": "6d6f61d4-2f81-4ddc-9963-7c30773edae1",
      "name": "Parse Score"
    },
    {
      "parameters": {
        "chatId": "={{ $('Code in JavaScript').item.json.chatId }}",
        "text": "=CV Match Analysis  Role: {{ $('Parse Score').item.json.role_name }} Overall Match: {{ $('Parse Score').item.json.overall_score }}%  Skills Match: {{ $('Parse Score').item.json.skills_score }}% Experience Match: {{ $('Parse Score').item.json.experience_score }}% Education Match: {{ $('Parse Score').item.json.education_score }}%  Matched Skills: {{ $('Parse Score').item.json.matched_skills_str }}  Missing Skills: {{ $('Parse Score').item.json.missing_skills_str }}  Strengths: {{ $('Parse Score').item.json.strengths }}  Gaps: {{ $('Parse Score').item.json.gaps }}  Verdict: {{ $('Parse Score').item.json.verdict }}",
